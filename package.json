{
  "name": "@crafter/li-metrics",
  "version": "0.1.0",
  "description": "Read-only LinkedIn post analytics CLI for authenticated browser sessions",
  "keywords": [
    "linkedin",
    "analytics",
    "cli",
    "agent-browser",
    "bun"
  ],
  "author": "Crafter Station",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafter-station/li-metrics.git"
  },
  "homepage": "https://github.com/crafter-station/li-metrics#readme",
  "bugs": {
    "url": "https://github.com/crafter-station/li-metrics/issues"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "bin": {
    "li-metrics": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.11 <2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:repeat": "bun test && bun test && bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check src tests package.json tsconfig.json biome.json README.md",
    "verify": "bun run typecheck && bun run check && bun test",
    "release:check": "bun run verify && bun pm pack --dry-run",
    "prepublishOnly": "bun run release:check"
  },
  "dependencies": {
    "agent-browser": ">=0.31.1 <0.34.0",
    "commander": "^14.0.2",
    "read-excel-file": "^9.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.3",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3"
  }
}
